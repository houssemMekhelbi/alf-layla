# Taskwarrior. Shown in waybar as "yawm" (~/.local/bin/waybar-yawm):
#   click        list popup   (~/.local/bin/layla-yawm -> layla-yawm-menu)
#   right-click  quick add    (~/.local/bin/layla-yawm add)
# Tasks tagged +note are notes: listed last, never counted in the bar.

data.location=~/.local/share/task
news.version=3.5.0
editor=nvim
weekstart=monday

# Alf Layla colours (256-colour approximations): overdue in rose, due today
# in lamp amber, notes in faience.
color.due.today=bold rgb542
color.due=rgb432
color.overdue=bold rgb523
color.tag.note=rgb144
color.active=rgb144
color.header=rgb334
color.label=rgb334
color.footnote=rgb223
