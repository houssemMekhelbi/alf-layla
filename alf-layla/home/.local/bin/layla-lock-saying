#!/usr/bin/env python3
"""Lock-screen saying (Alf Layla). No username.

    layla-lock-saying ar    the Arabic, one line per " / " part (hyprlock right-aligns it)
    layla-lock-saying en    the English under it
    layla-lock-saying       both on one line

Sayings come from ~/.config/hypr/alf-layla/sayings.txt, one per line as
"english | arabic". The saying changes every 10 minutes; the index comes from
the clock, so both labels show the same saying.
"""

import sys
import time
from html import escape
from pathlib import Path

SAYINGS = Path.home() / ".config/hypr/alf-layla/sayings.txt"
RLI, PDI = chr(0x2067), chr(0x2069)   # isolate each Arabic line so its direction is never guessed


def current():
    try:
        lines = [l.strip() for l in SAYINGS.read_text(encoding="utf-8").splitlines()]
    except OSError:
        return None
    sayings = [l for l in lines if l and not l.startswith("#")]
    if not sayings:
        return None
    english, _, arabic = sayings[int(time.time() // 600) % len(sayings)].partition("|")
    return english.strip(), [part.strip() for part in arabic.split(" / ") if part.strip()]


def main():
    saying = current()
    if not saying:
        return
    english, arabic = saying
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode == "ar":
        print("\n".join(f"{RLI}{escape(line)}{PDI}" for line in arabic))
    elif mode == "en":
        print(f"<i>{escape(english)}</i>")
    else:
        print(f"{escape(english)}  ·  {RLI}{escape(' '.join(arabic))}{PDI}")


if __name__ == "__main__":
    main()
